<?xml version="1.0" encoding="utf-8"?>
<!--
    ホーム画面(フェーズ0指示書 6章「案A」)。1024×600 の横画面。
    上部バー 56 / 中央 456(左の地図カード 400、右に 3列×2行のタイル) / 下部メニュー 88。
    寸法は案Aの値。画面が低い機種でも崩れないよう、中央だけは比率(weight)で伸び縮みする。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 上部バー: 時刻・日付 / デモ / 走行中 / GPS / 監視 / 接続(要件N7) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="H:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/demo_badge"
                style="@style/Badge"
                android:backgroundTint="@color/warn"
                android:text="デモ表示中"
                android:textColor="@color/bg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/driving_badge"
                style="@style/Badge"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/warn"
                android:text="走行中"
                android:textColor="@color/bg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gps_badge"
                style="@style/Badge"
                android:layout_marginStart="8dp"
                android:text="GPS" />

            <TextView
                android:id="@+id/monitor_badge"
                style="@style/Badge"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:id="@+id/conn_badge"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="88dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/conn_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_circle" />

                <TextView
                    android:id="@+id/conn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中央 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 左カード: 地図(要件U13) / 自宅へ・目的地を検索 / 再生中の曲 -->
            <LinearLayout
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/map_frame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/surface_high">

                    <TextView
                        android:id="@+id/map_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="地図を準備しています"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/map_attribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:background="#B30E1316"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="© OpenStreetMap contributors"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:layout_margin="8dp"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/zoom_in"
                            style="@style/IconButton"
                            android:contentDescription="拡大"
                            android:src="@drawable/ic_add" />

                        <ImageButton
                            android:id="@+id/zoom_out"
                            style="@style/IconButton"
                            android:layout_marginTop="8dp"
                            android:contentDescription="縮小"
                            android:src="@drawable/ic_remove" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_go_home"
                        style="@style/BigButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_home"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/accent"
                        android:text="自宅へ" />

                    <TextView
                        android:id="@+id/btn_search"
                        style="@style/BigButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1.3"
                        android:drawableStart="@drawable/ic_search"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/accent"
                        android:text="目的地を検索" />
                </LinearLayout>

                <!-- 再生中の曲と操作 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/np_info"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/np_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/np_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/np_prev"
                        style="@style/IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="前の曲"
                        android:src="@drawable/ic_skip_previous" />

                    <ImageButton
                        android:id="@+id/np_play"
                        style="@style/IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="再生・一時停止"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/np_next"
                        style="@style/IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="次の曲"
                        android:src="@drawable/ic_skip_next" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右: 3列×2行のタイル。上段「動画・音楽・電話」、下段「会議・CarPlay・ドラレコ」 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_video"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_play"
                        app:tileTitle="動画" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_music"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_music"
                        app:tileTitle="音楽" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_phone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_phone"
                        app:tileTitle="電話" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_meeting"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_meeting"
                        app:tileTitle="会議" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_carplay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_car"
                        app:tileTitle="CarPlay" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_dashcam"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent"
                        app:tileIcon="@drawable/ic_videocam"
                        app:tileTitle="ドラレコ" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 下部メニュー: ホーム・ラジオ・アプリ一覧・設定(4等分) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:tileAccent="@color/accent"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_home"
                app:tileTitle="ホーム" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_radio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_radio"
                app:tileTitle="ラジオ" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_apps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_apps"
                app:tileTitle="アプリ一覧" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_settings"
                app:tileTitle="設定" />
        </LinearLayout>
    </LinearLayout>

    <!-- 動画・音楽・会議のタイルを押したときに出る、アプリを選ぶパネル -->
    <FrameLayout
        android:id="@+id/picker_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/picker_card"
            style="@style/Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="560dp"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/picker_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/picker_close"
                    style="@style/IconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="閉じる"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:id="@+id/picker_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warn"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/picker_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/picker_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
