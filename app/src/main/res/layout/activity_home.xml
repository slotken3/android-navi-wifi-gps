<?xml version="1.0" encoding="utf-8"?>
<!--
    ホーム画面(要件U1〜U3)。1024×600 の横画面を想定。
    寸法は比率(weight)で決めるので、画面の密度が違っても崩れにくい。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 上段: 時計・日付・監視の状態 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="H:mm"
                android:format24Hour="H:mm"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/demo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/warn"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="デモ表示中"
                android:textColor="@color/bg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Wi-Fi監視が動いているか(スリープ復帰後に止められていないかを一目で見る) -->
            <LinearLayout
                android:id="@+id/monitor_chip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minWidth="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <View
                    android:id="@+id/monitor_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_circle" />

                <TextView
                    android:id="@+id/monitor_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中段: 大きなタイル -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/tile_navi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1.35"
                app:tileAccent="@color/accent_navi"
                app:tileIcon="@drawable/ic_navigation"
                app:tileLarge="true"
                app:tileTitle="ナビ" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_video"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_video"
                        app:tileIcon="@drawable/ic_play"
                        app:tileTitle="動画" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_music"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_music"
                        app:tileIcon="@drawable/ic_music"
                        app:tileTitle="音楽" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_meeting"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_meeting"
                        app:tileIcon="@drawable/ic_meeting"
                        app:tileTitle="会議" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_carplay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_carplay"
                        app:tileIcon="@drawable/ic_car"
                        app:tileTitle="CarPlay" />

                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_dashcam"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_dashcam"
                        app:tileIcon="@drawable/ic_videocam"
                        app:tileTitle="ドラレコ" />

                    <!-- 接続状態(要件N7)。アイコン・色・文字は状態に合わせて差し替える -->
                    <com.livraison.wifiwatchdog.home.TileView
                        android:id="@+id/tile_status"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:tileAccent="@color/accent_neutral"
                        app:tileIcon="@drawable/ic_wifi"
                        app:tileTitle="接続状態" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 下段: 純正の機能(要件U4)と設定 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_radio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_radio"
                app:tileTitle="ラジオ" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_phone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_phone"
                app:tileTitle="電話" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_apps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_apps"
                app:tileTitle="アプリ一覧" />

            <com.livraison.wifiwatchdog.home.TileView
                android:id="@+id/dock_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:tileAccent="@color/text_secondary"
                app:tileCompact="true"
                app:tileIcon="@drawable/ic_settings"
                app:tileTitle="設定" />
        </LinearLayout>
    </LinearLayout>

    <!-- 動画・音楽・会議のタイルを押したときに出る、アプリを選ぶパネル -->
    <FrameLayout
        android:id="@+id/picker_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/picker_card"
            style="@style/Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:clickable="true"
            android:focusable="true"
            android:minWidth="560dp"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/picker_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/picker_close"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_button"
                    android:contentDescription="閉じる"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/picker_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/warn"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/picker_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/picker_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
